# Jetson build settings. Edit this file on the Jetson before running build.sh.

# ON builds the supported ATS adapter and requires AlazarTech ARM64 headers,
# libATSApi.so, and a kernel driver compatible with the active JetPack kernel.
FMCW_JETSON_WITH_ALAZAR=ON
FMCW_JETSON_ALAZAR_SDK_ROOT=/usr/local/AlazarTech

# Jetson builds are CUDA/cuFFT-only. "auto" maps the Jetson model to a numeric
# architecture compatible with CMake 3.18 (Thor 110, Orin 87, Xavier 72,
# TX2 62, Nano/TX1 53). Set a number explicitly for an unknown model.
FMCW_JETSON_CUDA_ARCHITECTURES=auto

# Leave empty when Qt 6.2 or newer is installed in the system CMake search path.
FMCW_JETSON_QT_ROOT=

FMCW_JETSON_BUILD_TESTS=ON
FMCW_JETSON_BUILD_JOBS=auto
FMCW_JETSON_RUN_SMOKE_TEST=ON
